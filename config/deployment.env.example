# Copy this file to config/deployment.env and replace every REQUIRED value.
# This file must contain non-secret configuration and remote secret names only.

# Repository and execution
ELDERPATH_REPO_PATH=C:\Scripts\Git\elderpath
DEPLOYMENT_ROOT=C:\Scripts\Git\elderpath-deployment
BACKUP_ROOT=C:\Scripts\Git\elderpath-deployment\backups
INSTALL_MISSING_TOOLS=true
RUN_FULL_TEST_GATE=true
DEPLOY_STAGING=true
DEPLOY_PRODUCTION=true
CREATE_GITHUB_BINDINGS_PR=true
CONFIGURE_GITHUB_CI=true
CONFIGURE_WEEKLY_BACKUP_TASK=true

# Domain and operations (the zone must already be active in Cloudflare)
PRIMARY_DOMAIN=example.com
STAGING_APP_HOST=elderpath-staging.example.workers.dev
PRODUCTION_APP_HOST=example.com
EMAIL_SENDING_DOMAIN=mail.example.com
EMAIL_FROM=ElderPath <no-reply@mail.example.com>
OPERATIONS_EMAIL=ops@example.com
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
USE_CUSTOM_WORKER_DOMAINS=true

# Supabase (create two different Free projects before running Provision)
SUPABASE_REGION=us-west-2
SUPABASE_STAGING_PROJECT_REF=REQUIRED
SUPABASE_PRODUCTION_PROJECT_REF=REQUIRED
SUPABASE_STAGING_POOLER_HOST=REQUIRED
SUPABASE_PRODUCTION_POOLER_HOST=REQUIRED
SUPABASE_DATABASE_WARNING_BYTES=350000000
SUPABASE_DATABASE_BLOCK_BYTES=400000000
SUPABASE_CLI_VERSION=2.114.0

# Google Cloud
GCP_PROJECT_ID=elderpath-production
GCP_BILLING_ACCOUNT_ID=REQUIRED
GCP_REGION=us-west1
GCP_ARTIFACT_REPOSITORY=elderpath
GCP_RUNTIME_SERVICE_ACCOUNT=statecare-runtime
GCP_DEPLOY_SERVICE_ACCOUNT=elderpath-github-deploy
GCP_WORKLOAD_IDENTITY_POOL=github-actions
GCP_WORKLOAD_IDENTITY_PROVIDER=elderpath
GCP_MONTHLY_BUDGET_USD=10
GCP_ARTIFACT_KEEP_COUNT=3
STATECARE_STAGING_SERVICE=statecare-registry-staging
STATECARE_PRODUCTION_SERVICE=statecare-registry-production
STATECARE_MIN_INSTANCES=0
STATECARE_MAX_INSTANCES=1
STATECARE_CONCURRENCY=20
STATECARE_REQUEST_TIMEOUT_SECONDS=15

# Google Secret Manager resource names (not secret values)
STAGING_DATABASE_URL_SECRET=statecare-staging-database-url
STAGING_DATABASE_URL_SYNC_SECRET=statecare-staging-database-url-sync
STAGING_REGISTRY_KEY_SECRET=statecare-staging-registry-api-key
STAGING_ADMIN_KEY_SECRET=statecare-staging-admin-api-key
STAGING_GEOCODIO_API_KEY_SECRET=statecare-staging-geocodio-api-key
PRODUCTION_DATABASE_URL_SECRET=statecare-production-database-url
PRODUCTION_DATABASE_URL_SYNC_SECRET=statecare-production-database-url-sync
PRODUCTION_REGISTRY_KEY_SECRET=statecare-production-registry-api-key
PRODUCTION_ADMIN_KEY_SECRET=statecare-production-admin-api-key
PRODUCTION_GEOCODIO_API_KEY_SECRET=statecare-production-geocodio-api-key

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=REQUIRED
CLOUDFLARE_ZONE_ID=REQUIRED
CLOUDFLARE_WORKERS_SUBDOMAIN=example
CLOUDFLARE_STAGING_D1_NAME=elderpath-staging
CLOUDFLARE_PRODUCTION_D1_NAME=elderpath-production
CLOUDFLARE_STAGING_R2_BUCKET=elderpath-media-staging
CLOUDFLARE_PRODUCTION_R2_BUCKET=elderpath-media-production
CLOUDFLARE_D1_LOCATION=wnam
CLOUDFLARE_R2_LOCATION=wnam

# GitHub
GITHUB_OWNER=silverspringapps
GITHUB_REPOSITORY=elderpath
GITHUB_DEFAULT_BRANCH=main
GITHUB_STAGING_BRANCH=dev
GITHUB_DEPLOYMENT_MODE=free-private

# StateCare and geocoding
CALIFORNIA_RCFE_SOURCE_URL=https://data.chhs.ca.gov/datastore/dump/744d1583-f9eb-45b6-b0f8-b9a9dab936a6
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ElderPath-StateCare/1.0 (ops@example.com)
GEOCODER_PROCESS_AFTER_IMPORT_LIMIT=0
MENIFEE_GEOCODING_LIMIT=100
ENABLE_SOUTHERN_CALIFORNIA_GEOCODING=false
SOUTHERN_CALIFORNIA_GEOCODING_LIMIT=100
GEOCODIO_INITIAL_BATCH_SIZE=1000
GEOCODIO_INITIAL_MAX_ITEMS=13000
GEOCODIO_MIN_ACCURACY=0.8
GEOCODIO_ACCEPTED_ACCURACY_TYPES=rooftop,point,range_interpolation,nearest_rooftop_match
STATEWIDE_GEOCODING_REQUIRED_COVERAGE_PERCENT=99
CALIFORNIA_NOMINATIM_DELTA_LIMIT=100
CALIFORNIA_NOMINATIM_REQUESTS_PER_MINUTE=4

# AI and authentication (credentials are requested securely at runtime)
AI_USE_GROQ=false
AI_OPENAI_FALLBACK_ENABLED=false
AI_WEB_SEARCH_ENABLED=false
ENABLE_GOOGLE_OAUTH=false
OPENAI_MODEL=gpt-5.6-luna

# Monitoring and backups
READINESS_SCHEDULE=0 */8 * * *
BACKUP_DAY_OF_WEEK=Sunday
BACKUP_LOCAL_TIME=03:00
BACKUP_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=7
